{
  "name": "sidenote",
  "version": "0.1.0",
  "type": "module",
  "bin": { "sidenote": "dist/index.js" },
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "esbuild src/viewer/client/main.ts --bundle --format=esm --outfile=dist/client/main.js && cp src/viewer/client/index.html dist/client/index.html && cp node_modules/highlight.js/styles/atom-one-dark.css dist/client/hljs.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "highlight.js": "^11.10.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
